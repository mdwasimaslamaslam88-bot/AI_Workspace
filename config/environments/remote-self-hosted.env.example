# Private Tailscale Serve mode. The backend must still bind only to loopback.
APP_TITLE=WORK STATION Backend
BACKEND_CORS_ORIGINS=["tauri://localhost","http://tauri.localhost"]
REMOTE_GATEWAY_MODE=tailscale
WORK_STATION_WEB_ROOT=/absolute/path/to/AI_Workspace/frontend/dist
EDGE_AUTH_FAILURE_LIMIT=120
EDGE_PROVISIONING_LIMIT=10
EDGE_RATE_LIMIT_WINDOW_SECONDS=60
