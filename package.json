{
  "name": "work-station",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "shared",
    "frontend",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @work-station/web",
    "test": "(cd backend && .venv/bin/python -m pytest -q) && npm run test:web && npm run test --workspace @work-station/mobile",
    "test:web": "npm run test --workspace @work-station/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build:web && npm run build:static --workspace @work-station/mobile",
    "build:web": "npm run build --workspace @work-station/web",
    "check": "./scripts/release_check.sh",
    "check:mobile": "./scripts/mobile_check.sh",
    "check:mobile:native": "./scripts/mobile_check.sh --require-native-android",
    "check:desktop": "./scripts/desktop_check.sh",
    "check:desktop:launch": "./scripts/desktop_check.sh --require-launch",
    "check:postgres": "./scripts/postgres_integration_check.sh",
    "check:browser": "./scripts/postgres_integration_check.sh --browser-only",
    "security-audit": "./scripts/security_audit.sh",
    "package": "./scripts/desktop_check.sh",
    "package:desktop": "./scripts/desktop_check.sh",
    "package:mobile": "./scripts/mobile_check.sh --require-native-android",
    "e2e": "./scripts/postgres_integration_check.sh --runtime-only --with-browser",
    "release": "./scripts/release_check.sh --with-runtime --require-clean"
  },
  "devDependencies": {
    "expo-doctor": "1.20.2",
    "playwright": "1.62.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
