{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WORK STATION",
  "version": "0.1.0",
  "identifier": "com.workstation.personalai",
  "build": {
    "beforeDevCommand": "npm run dev:web --prefix ../..",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:web --prefix ../..",
    "frontendDist": "../../../frontend/dist"
  },
  "app": {
    "security": {
      "capabilities": ["main-window"],
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8000 http://localhost:8000 https://*.ts.net; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "WORK STATION",
        "width": 1440,
        "height": 920,
        "minWidth": 920,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "Private Personal AI workstation",
    "longDescription": "Owner-only desktop access to the WORK STATION Personal AI.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["work-station"]
      }
    }
  }
}
