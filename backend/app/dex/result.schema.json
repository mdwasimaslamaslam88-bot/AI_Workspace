{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "evidence",
    "ai_os_consulted",
    "confidence"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["VERIFIED", "BLOCKED", "FAILED"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "evidence": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "claim", "path", "sha256"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["analysis", "file", "command", "test", "ai_os"]
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "path": {
            "type": ["string", "null"],
            "maxLength": 512,
            "description": "Repository/workspace-relative path only for kind=file; null for every other kind."
          },
          "sha256": {
            "type": ["string", "null"],
            "pattern": "^[a-f0-9]{64}$",
            "description": "Exact current file-byte SHA-256 for kind=file and callback output SHA-256 for kind=ai_os."
          }
        }
      }
    },
    "ai_os_consulted": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
