APP_TITLE=WORK STATION Backend
APP_VERSION=0.1.0
BACKEND_CORS_ORIGINS=["http://localhost:3000","tauri://localhost","http://tauri.localhost"]
# Optional compiled PWA serving. Keep unset while using the Vite dev server.
# WORK_STATION_WEB_ROOT=/absolute/path/to/AI_Workspace/frontend/dist
# local or tailscale; tailscale is reported ready only through an HTTPS request.
REMOTE_GATEWAY_MODE=local

# SHA-256 digest of a 43-character operator token; omitted disables provisioning.
# Enabling provisioning also requires DATABASE_URL and an Alembic-upgraded schema.
# USER_PROVISIONING_TOKEN_DIGEST=<64 lowercase hexadecimal characters>

# Uncomment and set a real async PostgreSQL URL when PostgreSQL is configured.
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/workspace
# REDIS_URL=redis://:password@localhost:6379/0
# Private absolute storage outside the source tree.
# ASSET_STORAGE_ROOT=/absolute/private/path/to/assets
# Persistent hardware fingerprint outside the source tree; contains no secrets.
# HARDWARE_STATE_PATH=/absolute/private/path/to/hardware-capability-state.json
# Owner-only encrypted External AI vault outside the source tree. When set, the
# backend creates a 0700 directory and separate 0600 XChaCha20-Poly1305 key/file.
# EXTERNAL_AI_STATE_ROOT=/absolute/private/path/to/external-ai
# Owner-only connector credential key directory. Network egress remains denied
# until exact HTTPS or loopback origins are explicitly allowlisted.
# CONNECTOR_STATE_ROOT=/absolute/private/path/to/connectors
CONNECTOR_ALLOWED_ORIGINS=[]
# SELF_UPDATE_STATE_ROOT=/absolute/private/path/to/self-update
# Local AI runtime endpoints are restricted to loopback addresses.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Exact Ollama references verified to execute locally; empty fails closed.
OLLAMA_LOCAL_MODEL_ALLOWLIST=[]
# Optional evidence-backed automatic task routes. Every exact reference must
# also be allowlisted; a task-reserved model cannot spill into unrelated routes.
OLLAMA_TASK_MODEL_PREFERENCES={}
# Exact allowlisted embeddings model; omitted keeps legacy deterministic search only.
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# Isolated loopback-only ComfyUI runtime. The exact checkpoint and runtime-owned
# input/temp roots must live outside the source tree; the group is all-or-none.
# COMFYUI_BASE_URL=http://127.0.0.1:8188
# COMFYUI_CHECKPOINT=/absolute/path/to/comfyui/models/checkpoints/sd_xl_base_1.0.safetensors
# COMFYUI_INPUT_ROOT=/absolute/path/to/comfyui/input
# COMFYUI_TEMP_ROOT=/absolute/path/to/comfyui/temp
# COMFYUI_MODEL_REFERENCE=stabilityai/stable-diffusion-xl-base-1.0@<pinned-commit>
COMFYUI_MODEL_PROFILE=sdxl-base-1.0
COMFYUI_TIMEOUT_SECONDS=300.0
COMFYUI_MAX_ACTIVE_PER_PROCESS=1

# Isolated local speech runtimes. Each group is all-or-none and remains disabled
# until its exact executable/model files are installed outside the source tree.
# STT_PYTHON=/absolute/path/to/stt/.venv/bin/python
# STT_MODEL_ROOT=/absolute/path/to/stt/models/faster-whisper-small.en
# STT_MODEL_REFERENCE=Systran/faster-whisper-small.en@<pinned-commit>
# STT_LIBRARY_DIRECTORIES=["/absolute/path/to/cublas/lib","/absolute/path/to/cudnn/lib"]
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
STT_TIMEOUT_SECONDS=120.0
STT_MAX_ACTIVE_PER_PROCESS=1
# TTS_PIPER_BINARY=/absolute/path/to/tts/.venv/bin/piper
# TTS_VOICE_MODEL=/absolute/path/to/tts/voices/en_US-lessac-medium.onnx
# TTS_VOICE_CONFIG=/absolute/path/to/tts/voices/en_US-lessac-medium.onnx.json
# TTS_VOICE_REFERENCE=en_US-lessac-medium@<pinned-commit>
TTS_TIMEOUT_SECONDS=60.0
TTS_MAX_ACTIVE_PER_PROCESS=1

DATABASE_CONNECT_TIMEOUT_SECONDS=3.0
DATABASE_POOL_TIMEOUT_SECONDS=5.0
DATABASE_COMMAND_TIMEOUT_SECONDS=10.0
REDIS_CONNECT_TIMEOUT_SECONDS=3.0
OLLAMA_TIMEOUT_SECONDS=5.0
# Aggregate monotonic deadline for one shared full model-list discovery; maximum 300 seconds.
MODEL_LIST_MAX_DISCOVERY_SECONDS=60.0
# Aggregate public /api/v1/ai/models JSON response; accepted range is 1 byte through 1 MiB.
MODEL_LIST_MAX_RESPONSE_BYTES=1048576
# Per-response bound for /api/tags and /api/show; accepted range is 1 byte through 1 MiB.
OLLAMA_CATALOG_MAX_RESPONSE_BYTES=1048576
# Full-list installed allowlisted-model bound; accepted range is 1 through 256.
OLLAMA_CATALOG_MAX_LIST_MODELS=256
OLLAMA_GENERATION_TIMEOUT_SECONDS=120.0
# Bounded /api/chat request body; accepted range is 1 byte through 1 MiB.
OLLAMA_GENERATION_MAX_REQUEST_BYTES=1048576
# Bounded /api/chat response body; accepted range is 1 byte through 1 MiB.
OLLAMA_GENERATION_MAX_RESPONSE_BYTES=262144
# Unload after each request by default so model swaps cannot accumulate VRAM.
OLLAMA_KEEP_ALIVE_SECONDS=0
# Bounded local document embedding requests, responses, batches, and concurrency.
OLLAMA_EMBEDDING_TIMEOUT_SECONDS=60.0
OLLAMA_EMBEDDING_MAX_REQUEST_BYTES=1048576
OLLAMA_EMBEDDING_MAX_RESPONSE_BYTES=1048576
OLLAMA_EMBEDDING_BATCH_SIZE=16
OLLAMA_EMBEDDING_MAX_ACTIVE_PER_PROCESS=1
# Fail-fast local generation cap; accepted range is 1 through 8 per process.
GENERATION_MAX_ACTIVE_PER_PROCESS=1
# Hard wall-clock deadline for each admitted generation workflow (maximum 600 seconds).
GENERATION_MAX_DURATION_SECONDS=180.0
# Bounded local document parser/embedding workers; accepted range is 1 through 4.
DOCUMENT_INGESTION_MAX_ACTIVE_PER_PROCESS=2
# Total admitted ingestion deadline, including local parsing (maximum 300 seconds).
DOCUMENT_INGESTION_MAX_DURATION_SECONDS=30.0
# Raw HTTP request-body cap; accepted range is 1 byte through 1 MiB.
REQUEST_MAX_BODY_BYTES=262144
# In-process protection for the single loopback/Tailscale edge. No credentials
# or forwarded identity headers are stored by the limiter.
EDGE_AUTH_FAILURE_LIMIT=120
EDGE_PROVISIONING_LIMIT=10
EDGE_RATE_LIMIT_WINDOW_SECONDS=60

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
# Local development without TLS may use disable. Production should use verify-full.
DATABASE_SSL_MODE=disable
# DATABASE_SSL_ROOT_CERT=/run/secrets/postgresql-ca.pem

# Database integration tests require both the opt-in and a separate *_test database.
RUN_DATABASE_INTEGRATION_TESTS=false
# TEST_DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/ai_workspace_test
