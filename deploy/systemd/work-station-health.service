[Unit]
Description=Verify WORK STATION backend and dependency readiness
After=work-station-backend.service

[Service]
Type=oneshot
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 8 http://127.0.0.1:8000/api/v1/health/ready
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
