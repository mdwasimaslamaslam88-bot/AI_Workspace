[Unit]
Description=WORK STATION private Tailscale userspace daemon
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/AI_Workspace_Runtimes/tailscale/current/tailscaled

[Service]
Type=simple
ExecStart=%h/AI_Workspace_Runtimes/tailscale/current/tailscaled --tun=userspace-networking --state=%h/AI_Workspace_Data/tailscale/tailscaled.state --socket=%t/work-station-tailscale/tailscaled.sock
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=20s
RuntimeDirectory=work-station-tailscale
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/AI_Workspace_Data/tailscale
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryMax=1G
TasksMax=128
UMask=0077

[Install]
WantedBy=default.target
