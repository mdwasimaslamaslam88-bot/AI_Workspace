[Unit]
Description=Verify WORK STATION private remote gateway
After=work-station-backend.service

[Service]
Type=oneshot
ExecCondition=@REPOSITORY_ROOT@/scripts/tailscale_cli.sh version
ExecStart=@REPOSITORY_ROOT@/scripts/check_remote_gateway.sh
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
UMask=0077
